#!/usr/bin/env python3
"""Run the Gradle convention check in the current repository."""

import os
from pathlib import Path
import subprocess
import sys


def main() -> int:
    wrapper = Path.cwd() / "gradlew"
    if not wrapper.is_file() or not os.access(wrapper, os.X_OK):
        if (Path.cwd() / "tests" / "test_harness.py").is_file():
            tests = subprocess.run(
                [sys.executable, "-m", "unittest", "discover", "-s", "tests"], check=False,
            )
            if tests.returncode:
                return tests.returncode
            syntax = subprocess.run(
                [sys.executable, "-c",
                 "from pathlib import Path; files = [*Path('hooks').glob('*.py'), *Path('bin').glob('*')]; "
                 "[compile(p.read_bytes(), str(p), 'exec') for p in files if p.is_file()]"],
                check=False,
            )
            return syntax.returncode
        print("VERIFY requires an executable ./gradlew, but none was found.")
        return 2
    try:
        return subprocess.run([str(wrapper), "check"], check=False).returncode
    except OSError as exc:
        print(f"Could not start ./gradlew ({type(exc).__name__}).")
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
