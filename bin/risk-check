#!/usr/bin/env python3
"""Run the configured Local Risk Gate for the current Git project."""

from __future__ import annotations

import json
from pathlib import Path
import subprocess
import sys

from risk_gate_config import ConfigurationError, resolve_risk_gate_home


def emit(payload: dict[str, object], code: int) -> int:
    print(json.dumps(payload, separators=(",", ":")))
    return code


def main() -> int:
    try:
        home = resolve_risk_gate_home()
    except ConfigurationError as exc:
        return emit({"decision": "ERROR", "message": str(exc)}, 4)
    if home is None:
        return emit({"decision": "NOT_CONFIGURED", "message": "Configure riskGateHome in ~/.config/codex-harness/config.json or set RISK_GATE_HOME."}, 4)
    try:
        root = Path(subprocess.run(
            ["git", "rev-parse", "--show-toplevel"], check=True,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
        ).stdout.strip()).resolve()
    except (OSError, subprocess.CalledProcessError):
        return emit({"decision": "ERROR", "message": "Could not determine the current Git project root."}, 4)

    report = root / "build" / "reports" / "build-convention" / "report.json"
    if not report.is_file():
        return emit({"decision": "ERROR", "message": "Build Convention report is missing."}, 4)

    try:
        subprocess.run(
            [str(home / "gradlew"), "-p", str(home), "--quiet", "bootJar"],
            cwd=home, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
            timeout=900, check=True,
        )
        jars = sorted((home / "build" / "libs").glob("*.jar"))
        executable_jars = [jar for jar in jars if not jar.name.endswith("-plain.jar")]
        if len(executable_jars) != 1:
            raise RuntimeError("expected one executable Risk Gate jar")
    except (OSError, subprocess.CalledProcessError, subprocess.TimeoutExpired, RuntimeError) as exc:
        return emit({"decision": "ERROR", "message": f"Local Risk Gate could not be built ({type(exc).__name__})."}, 4)

    try:
        result = subprocess.run(
            ["java", "-jar", str(executable_jars[0]), "local", "--project", str(root)],
            cwd=root, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=900, check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return emit({"decision": "ERROR", "message": f"Local Risk Gate could not run ({type(exc).__name__})."}, 4)

    try:
        payload = json.loads(result.stdout)
        decision = payload.get("decision") if isinstance(payload, dict) else None
        reason_codes = payload.get("reasonCodes", []) if isinstance(payload, dict) else None
        code_for = {"PASS": 0, "REVIEW": 2, "BLOCK": 3, "ERROR": 4}
        if decision not in code_for or not isinstance(reason_codes, list) or not all(isinstance(code, str) for code in reason_codes):
            raise ValueError("invalid result fields")
        if result.returncode not in (0, 2, 3, 4):
            raise RuntimeError("unexpected process exit")
        if result.returncode != code_for[decision]:
            raise ValueError("exit code does not match decision")
        return emit({"decision": decision, "reasonCodes": reason_codes}, result.returncode)
    except (json.JSONDecodeError, ValueError, AttributeError, RuntimeError):
        message = "Local Risk Gate returned invalid output."
        if result.returncode not in (0, 2, 3, 4):
            message = f"Local Risk Gate execution failed (exit {result.returncode})."
            cli_errors = [line.strip() for line in result.stderr.splitlines()
                          if line.strip().startswith(("Local Risk Gate error:", "Local Risk Gate failed"))]
            if cli_errors:
                message += " " + cli_errors[-1][:300]
        return emit({"decision": "ERROR", "message": message}, 4)


if __name__ == "__main__":
    raise SystemExit(main())
